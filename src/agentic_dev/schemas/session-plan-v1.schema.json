{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szaher/agentic-dev/schemas/session-plan-v1.schema.json",
  "title": "agentic session plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "document_type", "status", "repository", "request", "task", "readiness", "skills", "capabilities", "trust", "tools", "invocations", "verification_kinds", "isolation", "visibility", "blockers", "request_digest", "inputs_digest", "plan_digest"],
  "allOf": [
    {"if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
     "then": {"properties": {"blockers": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
     "then": {"properties": {"blockers": {"minItems": 1}}}}
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "agentic.session-plan"},
    "status": {"enum": ["ready", "blocked"]},
    "repository": {"type": "string"},
    "request": {"$ref": "#/$defs/canonical_request"},
    "task": {"type": "string"},
    "readiness": {
      "type": "object", "additionalProperties": false, "required": ["minimum", "current", "met"],
      "properties": {"minimum": {"$ref": "#/$defs/readiness_level"}, "current": {"$ref": "#/$defs/readiness_level"}, "met": {"type": "boolean"}}
    },
    "skills": {
      "type": "object", "additionalProperties": false, "required": ["selected", "not_exposed"],
      "properties": {
        "selected": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["name", "provider", "content_digest"],
          "properties": {"name": {"type": "string"}, "provider": {"type": "string"}, "content_digest": {"$ref": "#/$defs/digest"}}}},
        "not_exposed": {"$ref": "#/$defs/strings"}
      }
    },
    "capabilities": {"$ref": "#/$defs/strings"},
    "tools": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["name", "available", "configured", "version"],
      "properties": {"name": {"enum": ["serena", "codegraph"]}, "available": {"type": "boolean"},
        "configured": {"type": "boolean"}, "version": {"type": ["string", "null"]}}}},
    "trust": {
      "type": "object", "additionalProperties": false, "required": ["profile", "permissions", "ceilings"],
      "properties": {"profile": {"type": "string"}, "permissions": {"$ref": "#/$defs/strings"}, "ceilings": {"$ref": "#/$defs/strings"}}
    },
    "invocations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invocation"},
      "contains": {"type": "object", "properties": {"role": {"const": "implementer"}}, "required": ["role"]},
      "minContains": 1, "maxContains": 1},
    "verification_kinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["build", "test", "lint", "typecheck"]}},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["workspace_required", "workspace_created", "writable_scope"],
      "properties": {"workspace_required": {"const": true}, "workspace_created": {"const": false},
        "writable_scope": {"const": "prepared-workspace"}}},
    "visibility": {"type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {"status": {"const": "undetermined"}}},
    "blockers": {"type": "array", "items": {"type": "object", "required": ["code", "detail"],
      "properties": {"code": {"type": "string"}, "detail": {"type": "string"}, "invocation": {"type": "string"}, "dimension": {"type": "string"}},
      "additionalProperties": false}},
    "request_digest": {"$ref": "#/$defs/digest"},
    "inputs_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "canonical_request": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "document_type", "task", "invocations"],
      "properties": {
        "schema_version": {"const": "1"}, "document_type": {"const": "agentic.session-request"},
        "task": {"type": "string", "minLength": 1},
        "invocations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request_invocation"},
          "contains": {"properties": {"role": {"const": "implementer"}}, "required": ["role"]},
          "minContains": 1, "maxContains": 1},
        "readiness_minimum": {"$ref": "#/$defs/readiness_level"},
        "required_capabilities": {"$ref": "#/$defs/strings"},
        "allowed_skills": {"$ref": "#/$defs/strings"},
        "required_skills": {"$ref": "#/$defs/strings"},
        "trust_profile": {"type": "string", "minLength": 1},
        "trust_ceiling": {"type": "string", "minLength": 1},
        "verification_kinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["build", "test", "lint", "typecheck"]}}
      }},
    "request_invocation": {"type": "object", "additionalProperties": false,
      "required": ["id", "role", "permissions"],
      "if": {"properties": {"role": {"const": "reviewer"}}, "required": ["role"]},
      "then": {"properties": {"permissions": {"properties": {"filesystem": {"properties": {
        "minimum": {"const": "read-only"}, "maximum": {"const": "read-only"}}}}}}},
      "properties": {"id": {"type": "string", "minLength": 1},
        "role": {"enum": ["implementer", "reviewer"]},
        "harness": {"enum": ["claude", "codex", "pi", "opencode"]},
        "permissions": {"type": "object", "additionalProperties": false, "required": ["filesystem", "network"],
          "properties": {"filesystem": {"$ref": "#/$defs/filesystem_bound"},
            "network": {"$ref": "#/$defs/network_bound"}}}}
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readiness_level": {"enum": ["unaware", "foundational", "structured", "optimized", "autonomous"]},
    "strings": {"type": "array", "items": {"type": "string"}},
    "filesystem_level": {"enum": ["read-only", "workspace-write"]},
    "network_level": {"enum": ["off", "on"]},
    "filesystem_bound": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"],
      "properties": {"minimum": {"$ref": "#/$defs/filesystem_level"}, "maximum": {"$ref": "#/$defs/filesystem_level"}}},
    "network_bound": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"],
      "properties": {"minimum": {"$ref": "#/$defs/network_level"}, "maximum": {"$ref": "#/$defs/network_level"}}},
    "filesystem_effective": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "profile_ceiling", "level"],
      "properties": {"minimum": {"$ref": "#/$defs/filesystem_level"}, "maximum": {"$ref": "#/$defs/filesystem_level"},
        "profile_ceiling": {"$ref": "#/$defs/filesystem_level"}, "level": {"$ref": "#/$defs/filesystem_level"}}},
    "network_effective": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "profile_ceiling", "level"],
      "properties": {"minimum": {"$ref": "#/$defs/network_level"}, "maximum": {"$ref": "#/$defs/network_level"},
        "profile_ceiling": {"$ref": "#/$defs/network_level"}, "level": {"$ref": "#/$defs/network_level"}}},
    "enforcement": {"type": "object", "additionalProperties": false, "required": ["mechanism", "evidence", "probe_id"],
      "properties": {"mechanism": {"type": ["string", "null"]}, "evidence": {"type": "string"},
        "probe_id": {"type": ["string", "null"]}}},
    "filesystem_permission": {"type": "object", "additionalProperties": false, "required": ["requested", "effective", "enforceable", "enforcement"],
      "properties": {
        "requested": {"$ref": "#/$defs/filesystem_bound"}, "effective": {"$ref": "#/$defs/filesystem_effective"},
        "enforceable": {"enum": ["enforceable", "unenforceable", "unknown"]},
        "enforcement": {"$ref": "#/$defs/enforcement"}
      }},
    "network_permission": {"type": "object", "additionalProperties": false, "required": ["requested", "effective", "enforceable", "enforcement"],
      "properties": {
        "requested": {"$ref": "#/$defs/network_bound"}, "effective": {"$ref": "#/$defs/network_effective"},
        "enforceable": {"enum": ["enforceable", "unenforceable", "unknown"]},
        "enforcement": {"$ref": "#/$defs/enforcement"}
      }},
    "invocation": {"type": "object", "additionalProperties": false,
      "required": ["id", "role", "harness", "version", "permissions"],
      "properties": {"id": {"type": "string"}, "role": {"enum": ["implementer", "reviewer"]},
        "harness": {"enum": ["claude", "codex", "pi", "opencode"]}, "version": {"type": ["string", "null"]},
        "permissions": {"type": "object", "additionalProperties": false, "required": ["filesystem", "network"],
          "properties": {"filesystem": {"$ref": "#/$defs/filesystem_permission"}, "network": {"$ref": "#/$defs/network_permission"}}}}
    }
  }
}
