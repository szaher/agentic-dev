{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szaher/agentic-dev/schemas/provider-manifest-v1.schema.json",
  "title": "agentic provider manifest v1",
  "type": "object",
  "required": ["schema_version", "name", "version", "description"],
  "properties": {
    "schema_version": {"const": "1"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "compatibility": {
      "type": "object",
      "properties": {
        "agentic": {"type": "string"},
        "platforms": {"type": "array", "items": {"enum": ["macos", "linux", "wsl", "windows"]}}
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "executables": {"type": "array", "items": {"type": "string"}},
        "agents": {"type": "array", "items": {"type": "string"}}
      }
    },
    "skills": {"type": "array", "items": {"type": "object"}},
    "capabilities": {"type": "array", "items": {"type": "object"}},
    "migrations": {"type": "array", "items": {"type": "object"}}
  }
}
