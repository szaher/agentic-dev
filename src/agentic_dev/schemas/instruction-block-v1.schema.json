{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szaher/agentic-dev/schemas/instruction-block-v1.schema.json",
  "title": "agentic instruction block v1",
  "description": "Output of `agentic instructions block put|remove --json`. A tool owns the content of one managed block `<owner>.<id>` in a shared instruction file; Agentic Dev owns the mutation. Statuses created/appended/replaced/unchanged/removed/absent exit 0; conflict/refused exit 1 with nothing written; rolled-back exits 3. Usage errors exit 2 without a document.",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "repository",
    "action",
    "dry_run",
    "file",
    "owner",
    "id",
    "block_id",
    "status",
    "written",
    "reason",
    "content_sha256",
    "diff",
    "exit_code"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "document_type": {
      "const": "agentic.instruction-block"
    },
    "repository": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "action": {
      "enum": [
        "put",
        "remove"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "file": {
      "enum": [
        "AGENTS.md",
        "CLAUDE.md",
        ".claude/CLAUDE.md",
        "GEMINI.md",
        ".github/copilot-instructions.md"
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "The tool that owns the block. `readiness` and every owner starting with `agentic` are reserved for Agentic Dev.",
      "not": {
        "anyOf": [
          {
            "const": "readiness"
          },
          {
            "pattern": "^agentic"
          }
        ]
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "block_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "created",
        "appended",
        "replaced",
        "unchanged",
        "removed",
        "absent",
        "conflict",
        "refused",
        "rolled-back"
      ]
    },
    "written": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "diff": {
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        3
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "created",
              "appended",
              "replaced",
              "unchanged",
              "removed",
              "absent"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "conflict",
              "refused"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 1
          },
          "written": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rolled-back"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 3
          },
          "written": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "written": {
            "const": false
          }
        }
      }
    }
  ]
}
