{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szaher/agentic-dev/schemas/metric-event-v1.schema.json",
  "title": "agentic metric event v1",
  "type": "object",
  "required": ["schema_version", "document_type", "timestamp", "event_type", "data"],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "agentic.metric-event"},
    "timestamp": {"type": "string"},
    "event_type": {"type": "string"},
    "repository": {"type": ["object", "null"]},
    "session_id": {"type": ["string", "null"]},
    "data": {"type": "object"}
  }
}
