{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szaher/agentic-dev/schemas/provider-source-v1.schema.json",
  "title": "agentic provider source v1",
  "description": "Output of `agentic providers inspect SOURCE --json`: a provider source described exactly as `agentic providers add` would record it, without installing. `content_digest` uses the installation algorithm, so it can be compared with an installed provider's `content_digest` and passed to `providers add --sha256`.",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "name",
    "version",
    "manifest_digest",
    "content_digest",
    "source_type",
    "source",
    "skills",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "document_type": {
      "const": "agentic.provider-source"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compatibility": {
      "type": "object"
    },
    "source_type": {
      "enum": [
        "local",
        "git"
      ]
    },
    "source": {
      "type": "string"
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "signed_commit": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "signature_status": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
