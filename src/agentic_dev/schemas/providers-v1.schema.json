{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szaher/agentic-dev/schemas/providers-v1.schema.json",
  "title": "agentic providers v1",
  "description": "Output of `agentic providers list --json`: installed providers. `verified` is true only when the installed content still matches `content_digest`; unverified providers are not loaded.",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "document_type": {
      "const": "agentic.providers"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "manifest_digest",
          "content_digest",
          "source_type",
          "source",
          "installed",
          "verified",
          "compatible"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "manifest_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "compatibility": {
            "type": "object"
          },
          "source_type": {
            "enum": [
              "local",
              "git"
            ]
          },
          "source": {
            "type": "string"
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "signed_commit": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "signature_status": {
            "type": "string"
          },
          "installed": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          },
          "compatible": {
            "type": "boolean"
          },
          "manifest_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
