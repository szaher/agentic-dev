{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szaher/agentic-dev/schemas/session-record-v1.schema.json",
  "title": "agentic session record v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "document_type", "status", "repository", "workspace", "commit", "plan_digest", "request_digest", "inputs_digest", "profile_digest", "agentic_version", "contracts", "skills", "capabilities", "trust", "readiness", "tools", "invocations", "visibility", "prepared"],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "agentic.session-record"},
    "status": {"const": "prepared"},
    "repository": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "inputs_digest": {"$ref": "#/$defs/digest"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "agentic_version": {"type": "string", "minLength": 1},
    "contracts": {"type": "object", "required": ["schema_version", "document_type", "agentic_version", "contracts", "features", "exit_codes"],
      "properties": {"schema_version": {"const": "1"}, "document_type": {"const": "agentic.contracts"},
        "agentic_version": {"type": "string"}, "contracts": {"type": "object"},
        "features": {"type": "array", "items": {"type": "string"}}, "exit_codes": {"type": "object"}}},
    "skills": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["name", "provider", "content_digest"],
      "properties": {"name": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/digest"}}}},
    "capabilities": {"$ref": "#/$defs/strings"},
    "trust": {"type": "object", "additionalProperties": false, "required": ["profile", "permissions", "ceilings"],
      "properties": {"profile": {"type": "string"}, "permissions": {"$ref": "#/$defs/strings"},
        "ceilings": {"$ref": "#/$defs/strings"}}},
    "readiness": {"type": "object", "additionalProperties": false, "required": ["minimum", "current", "met"],
      "properties": {"minimum": {"$ref": "#/$defs/readiness_level"},
        "current": {"$ref": "#/$defs/readiness_level"}, "met": {"type": "boolean"}}},
    "tools": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["name", "available", "configured"],
      "properties": {"name": {"enum": ["serena", "codegraph"]}, "available": {"type": "boolean"},
        "configured": {"type": "boolean"}}}},
    "invocations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invocation"},
      "contains": {"properties": {"role": {"const": "implementer"}}, "required": ["role"]},
      "minContains": 1, "maxContains": 1},
    "visibility": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["harness", "prepared_skills", "detected_external", "undetermined"],
      "properties": {"harness": {"enum": ["claude", "codex", "pi", "opencode"]},
        "prepared_skills": {"$ref": "#/$defs/strings"},
        "detected_external": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {"kind": {"enum": ["workspace-skill", "workspace-config", "user-path-present"]},
            "path": {"type": "string"}}}},
        "undetermined": {"$ref": "#/$defs/strings"}}}},
    "prepared": {"type": "object", "additionalProperties": false,
      "required": ["skill_paths", "git_excluded"],
      "properties": {"skill_paths": {"$ref": "#/$defs/strings"}, "git_excluded": {"const": true}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "readiness_level": {"enum": ["unaware", "foundational", "structured", "optimized", "autonomous"]},
    "filesystem_level": {"enum": ["read-only", "workspace-write"]},
    "network_level": {"enum": ["off", "on"]},
    "filesystem_bound": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"],
      "properties": {"minimum": {"$ref": "#/$defs/filesystem_level"}, "maximum": {"$ref": "#/$defs/filesystem_level"}}},
    "network_bound": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"],
      "properties": {"minimum": {"$ref": "#/$defs/network_level"}, "maximum": {"$ref": "#/$defs/network_level"}}},
    "filesystem_effective": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "profile_ceiling", "level"],
      "properties": {"minimum": {"$ref": "#/$defs/filesystem_level"}, "maximum": {"$ref": "#/$defs/filesystem_level"},
        "profile_ceiling": {"$ref": "#/$defs/filesystem_level"}, "level": {"$ref": "#/$defs/filesystem_level"}}},
    "network_effective": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "profile_ceiling", "level"],
      "properties": {"minimum": {"$ref": "#/$defs/network_level"}, "maximum": {"$ref": "#/$defs/network_level"},
        "profile_ceiling": {"$ref": "#/$defs/network_level"}, "level": {"$ref": "#/$defs/network_level"}}},
    "enforcement": {"type": "object", "additionalProperties": false, "required": ["mechanism", "evidence", "probe_id"],
      "properties": {"mechanism": {"type": ["string", "null"]}, "evidence": {"type": "string"},
        "probe_id": {"type": ["string", "null"]}}},
    "filesystem_permission": {"type": "object", "additionalProperties": false, "required": ["requested", "effective", "enforceable", "enforcement"],
      "properties": {"requested": {"$ref": "#/$defs/filesystem_bound"}, "effective": {"$ref": "#/$defs/filesystem_effective"},
        "enforceable": {"const": "enforceable"}, "enforcement": {"$ref": "#/$defs/enforcement"}}},
    "network_permission": {"type": "object", "additionalProperties": false, "required": ["requested", "effective", "enforceable", "enforcement"],
      "properties": {"requested": {"$ref": "#/$defs/network_bound"}, "effective": {"$ref": "#/$defs/network_effective"},
        "enforceable": {"const": "enforceable"}, "enforcement": {"$ref": "#/$defs/enforcement"}}},
    "invocation": {"type": "object", "additionalProperties": false,
      "required": ["id", "role", "harness", "version", "permissions"],
      "properties": {"id": {"type": "string", "minLength": 1}, "role": {"enum": ["implementer", "reviewer"]},
        "harness": {"enum": ["claude", "codex", "pi", "opencode"]},
        "version": {"type": ["string", "null"]},
        "permissions": {"type": "object", "additionalProperties": false, "required": ["filesystem", "network"],
          "properties": {"filesystem": {"$ref": "#/$defs/filesystem_permission"},
            "network": {"$ref": "#/$defs/network_permission"}}}}
    }
  }
}
