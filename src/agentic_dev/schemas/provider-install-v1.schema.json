{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szaher/agentic-dev/schemas/provider-install-v1.schema.json",
  "title": "agentic provider install v1",
  "description": "Output of `agentic providers add SOURCE --json`. Installing replaces any provider with the same name; consumers that must not replace another installation check `agentic providers list --json` first and pin the source with `--sha256`.",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "name",
    "version",
    "manifest_digest",
    "content_digest",
    "source_type",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "document_type": {
      "const": "agentic.provider-install"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compatibility": {
      "type": "object"
    },
    "source_type": {
      "enum": [
        "local",
        "git"
      ]
    },
    "source": {
      "type": "string"
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "signed_commit": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "signature_status": {
      "type": "string"
    }
  }
}
