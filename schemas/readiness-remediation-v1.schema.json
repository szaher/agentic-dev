{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szaher/agentic-dev/schemas/readiness-remediation-v1.schema.json",
  "title": "agentic readiness remediation v1",
  "description": "What can safely be changed toward a target maturity level. remediations are tied to Agent Ready rules and capped by the spec's remediation classification (never upgraded). maintenance_actions are operational scaffolding for the readiness lifecycle, not rules; they must be evidence-neutral. changes are declarative managed-block edits, each owned by exactly one of the two. See docs/REMEDIATION.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "assessor",
    "spec",
    "repository",
    "mode",
    "maturity",
    "remediations",
    "maintenance_actions",
    "maintenance_skipped",
    "changes",
    "summary",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "document_type": {
      "const": "agentic.readiness-remediation"
    },
    "assessor": {
      "$ref": "#/$defs/assessor"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "mode": {
      "enum": [
        "preview",
        "dry-run",
        "applied"
      ],
      "description": "preview: proposal only. dry-run: planned outcomes and diffs, nothing written (ready diff, ready apply --dry-run). applied: changes were written (ready apply)."
    },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "target",
        "target_met"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/level"
        },
        "target": {
          "$ref": "#/$defs/level"
        },
        "target_met": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe_automatic",
        "human_decision",
        "unsupported",
        "maintenance_actions",
        "changes"
      ],
      "properties": {
        "safe_automatic": {
          "type": "integer",
          "minimum": 0
        },
        "human_decision": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "maintenance_actions": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "remediations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/remediation"
      },
      "description": "One entry per open Agent Ready rule up to the target. remediation_class is capped by the spec classification."
    },
    "maintenance_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/maintenanceAction"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "written",
        "maturity_after"
      ],
      "properties": {
        "status": {
          "enum": [
            "planned",
            "applied",
            "no-op",
            "conflict"
          ],
          "description": "conflict: at least one change was refused or conflicted, so nothing was written."
        },
        "written": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relpath"
          }
        },
        "maturity_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/level"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scope": {
      "enum": [
        "local",
        "ci"
      ],
      "description": "local: the working tree. ci: only files tracked by Git (what a CI checkout contains); untracked or Git-excluded local state is never evidence."
    },
    "maintenance_skipped": {
      "type": "array",
      "description": "Requested maintenance actions that were not proposed, and why.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/maintenanceId"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "agentic-dev"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "enum": [
            "builtin",
            "path"
          ]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision"
      ],
      "description": "Identifies the checkout without exposing absolute paths.",
      "properties": {
        "name": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        }
      }
    },
    "level": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^(context|conventions|constraints|feedback)(\\.[a-z][a-z0-9_]*)+$"
    },
    "severity": {
      "enum": [
        "required",
        "recommended",
        "advisory"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          {
            "pattern": "^\\.git(/|$)"
          },
          {
            "pattern": "\\\\"
          }
        ]
      },
      "description": "Normalized repository-relative path outside .git/."
    },
    "remediationClass": {
      "enum": [
        "safe-automatic",
        "human-decision",
        "unsupported"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type",
        "value",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "evidence",
            "spec"
          ],
          "description": "evidence: observed in the repository; spec: content defined by the Agent Ready spec."
        },
        "type": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "format",
        "block_id",
        "content",
        "content_sha256",
        "prelude",
        "target",
        "provenance",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^readiness\\.[a-z0-9][a-z0-9.-]*@.+$",
          "description": "<block_id>@<path>"
        },
        "kind": {
          "enum": [
            "managed-block"
          ]
        },
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "format": {
          "enum": [
            "markdown",
            "hash"
          ]
        },
        "block_id": {
          "type": "string",
          "pattern": "^readiness\\.[a-z0-9][a-z0-9.-]*$"
        },
        "content": {
          "type": "string",
          "description": "Block body without markers; normalized to end with one newline.",
          "not": {
            "pattern": "agentic-dev:"
          }
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prelude": {
          "type": [
            "string",
            "null"
          ],
          "description": "Written before the block only when the action creates the file."
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exists",
            "sha256",
            "tracked"
          ],
          "description": "Precondition captured at preview time. Apply refuses when the target has changed.",
          "properties": {
            "exists": {
              "type": "boolean"
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tracked": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "owner": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "rules"
              ],
              "properties": {
                "type": {
                  "const": "remediation"
                },
                "rules": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/ruleId"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "maintenance-action"
                },
                "id": {
                  "$ref": "#/$defs/maintenanceId"
                }
              }
            }
          ],
          "description": "Exactly one owner. Maintenance-owned changes never name rules."
        }
      }
    },
    "maintenanceId": {
      "type": "string",
      "pattern": "^readiness\\.[a-z0-9][a-z0-9.-]*$"
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "severity",
        "required_from",
        "status",
        "spec_classification",
        "remediation_class",
        "reason",
        "change_ids",
        "decision",
        "depends_on"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/ruleId"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "required_from": {
          "$ref": "#/$defs/level"
        },
        "status": {
          "enum": [
            "fail",
            "unknown",
            "pass"
          ],
          "description": "pass only for refreshing a stale managed block a passing rule already owns."
        },
        "spec_classification": {
          "enum": [
            "automatable",
            "assisted",
            "human-required"
          ]
        },
        "remediation_class": {
          "$ref": "#/$defs/remediationClass"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question",
                "guidance",
                "candidates"
              ],
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "guidance": {
                  "type": "string"
                },
                "candidates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/candidate"
                  },
                  "description": "Detected options shown to a person. Never selected automatically."
                }
              }
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleId"
          }
        },
        "change_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "spec_classification": {
                "const": "assisted"
              }
            }
          },
          "then": {
            "properties": {
              "remediation_class": {
                "enum": [
                  "human-decision",
                  "unsupported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "spec_classification": {
                "const": "human-required"
              }
            }
          },
          "then": {
            "properties": {
              "remediation_class": {
                "const": "human-decision"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "remediation_class": {
                "const": "safe-automatic"
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "type": "null"
              },
              "change_ids": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "change_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "remediation_class": {
                "const": "human-decision"
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "remediation_class": {
                "const": "safe-automatic"
              }
            }
          }
        }
      ]
    },
    "maintenanceAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "kind",
        "title",
        "reason",
        "source",
        "change_ids"
      ],
      "description": "Operational scaffolding for the Agentic Dev readiness lifecycle (for example a readiness CI check). Not an Agent Ready rule: it never references rules, must not create evidence any rule depends on, and is not evidence that a readiness requirement is met.",
      "properties": {
        "id": {
          "$ref": "#/$defs/maintenanceId"
        },
        "class": {
          "const": "safe-automatic"
        },
        "kind": {
          "const": "maintenance-action"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "contract"
          ],
          "properties": {
            "type": {
              "const": "agentic-dev"
            },
            "contract": {
              "const": "readiness-remediation-v1"
            }
          }
        },
        "change_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "rule_id"
            ]
          },
          {
            "required": [
              "rules"
            ]
          },
          {
            "required": [
              "spec_classification"
            ]
          }
        ]
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "path",
        "owner",
        "outcome",
        "reason",
        "ci_visible",
        "diff"
      ],
      "properties": {
        "change_id": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "owner": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "rules"
              ],
              "properties": {
                "type": {
                  "const": "remediation"
                },
                "rules": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/ruleId"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "maintenance-action"
                },
                "id": {
                  "$ref": "#/$defs/maintenanceId"
                }
              }
            }
          ],
          "description": "Exactly one owner. Maintenance-owned changes never name rules."
        },
        "outcome": {
          "enum": [
            "create",
            "append",
            "replace",
            "unchanged",
            "conflict",
            "refused"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "ci_visible": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether Git tracks the target. false means the change improves local readiness only."
        },
        "diff": {
          "type": "string",
          "description": "Unified diff for the file (attached to the file's first change)."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "dry-run",
              "applied"
            ]
          }
        }
      },
      "then": {
        "required": [
          "outcomes",
          "result"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "outcomes"
              ]
            },
            {
              "required": [
                "result"
              ]
            }
          ]
        }
      }
    }
  ]
}
